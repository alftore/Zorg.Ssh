<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Async SSH client and server library for .NET, with SFTP. Reviewed internally and by AI agents, not by an external audit. The server isn't meant for the public internet or for users you don't trust.</Description>
    <PackageTags>ssh;sftp;openssh;async</PackageTags>
    <!-- Only for source-generated LibraryImport stubs (file type checks, Linux directory listings for the SFTP server, the Windows agent pipe). No unsafe code is written by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zorg.Ssh.Tests" />
    <InternalsVisibleTo Include="Zorg.Ssh.InteropTests" />
    <InternalsVisibleTo Include="Zorg.Ssh.Benchmarks" />
    <InternalsVisibleTo Include="Zorg.Ssh.AotSmoke" />
    <InternalsVisibleTo Include="Zorg.Ssh.Fuzz" />
  </ItemGroup>

</Project>
