{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "Build and test (windows-latest)", "integration_id": 15368 },
          { "context": "Build and test (ubuntu-latest)", "integration_id": 15368 },
          { "context": "Build and test (macos-latest)", "integration_id": 15368 },
          { "context": "AOT smoke publish", "integration_id": 15368 },
          { "context": "Interop tests (ubuntu-latest, Docker)", "integration_id": 15368 },
          { "context": "Test on the .NET 11 runtime (ubuntu-latest)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
